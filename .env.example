# Postgres connection string (Neon or any Postgres).
# Without it, bookings are stored in .data/store.json for local development only.
DATABASE_URL=

# Passcode for the owner dashboard at /admin. Required in production.
ADMIN_PASSCODE=

# Independent session signing secret: at least 32 random characters.
# Required for admin login. Never reuse ADMIN_PASSCODE or commit real secrets.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Canonical site URL. Optional on Vercel (uses the production deployment URL).
NEXT_PUBLIC_SITE_URL=

# Optional: set only if a trusted edge proxy overwrites this header and strips
# client-supplied copies. Supported: cf-connecting-ip or x-real-ip.
# Otherwise login attempts share an unidentified-client bucket.
TRUSTED_CLIENT_IP_HEADER=
